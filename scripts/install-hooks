#!/bin/sh
# Install pre-commit and pre-push hooks (only when a denylist exists).
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
ws="${GROWTH_LAB_WORKSPACE:-workspace}"
if [ ! -f "$ws/public-denylist.txt" ]; then
  echo "No denylist, hooks not installed: $ws/public-denylist.txt" >&2
  exit 1
fi
hooks=$(git rev-parse --git-path hooks)
mkdir -p "$hooks"
cat > "$hooks/pre-commit" <<'HOOK'
#!/bin/sh
exec node src/cli.ts public-check --require-denylist
HOOK
cat > "$hooks/pre-push" <<'HOOK'
#!/bin/sh
exec node src/cli.ts public-check --history --require-denylist
HOOK
chmod +x "$hooks/pre-commit" "$hooks/pre-push"
echo "Hooks installed: $hooks/pre-commit, $hooks/pre-push"
