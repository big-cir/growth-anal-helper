{
  "type": "object",
  "title": "growth-lab agent action",
  "description": "매 턴 행동 하나를 step에 담는다: ask(되묻기) | probe(탐색 SQL 1개) | panel(패널 사양) | refuse(못 하는 이유와 대안)",
  "additionalProperties": false,
  "required": [
    "step"
  ],
  "properties": {
    "step": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "questions"
          ],
          "properties": {
            "action": {
              "const": "ask"
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text",
                  "options",
                  "allow_free_text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z_]{1,32}$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "is_default"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "maxLength": 60
                        },
                        "is_default": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "allow_free_text": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "plan",
            "purpose",
            "sql"
          ],
          "properties": {
            "action": {
              "const": "probe"
            },
            "plan": {
              "type": "string",
              "maxLength": 200
            },
            "purpose": {
              "type": "string",
              "maxLength": 100
            },
            "sql": {
              "type": "string",
              "maxLength": 8000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "plan",
            "panel"
          ],
          "properties": {
            "action": {
              "const": "panel"
            },
            "plan": {
              "type": "string",
              "maxLength": 300
            },
            "panel": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "title",
                "question",
                "sql",
                "display",
                "definition",
                "caveats",
                "answers"
              ],
              "properties": {
                "metric": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "지표 사전 id. 사전에 해당하는 지표가 없으면 null",
                  "maxLength": 48
                },
                "title": {
                  "type": "string",
                  "maxLength": 60
                },
                "question": {
                  "type": "string",
                  "maxLength": 300
                },
                "sql": {
                  "type": "string",
                  "maxLength": 12000
                },
                "display": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "number",
                        "table",
                        "line",
                        "bar",
                        "funnel",
                        "cohort"
                      ]
                    },
                    "x": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "numerator": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "denominator": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "series": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "step_no": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "step_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "reached": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "eligible": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "unknown": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "cohort": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "period": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "deleted_n": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "extra": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "key": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "headline": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "x": {
                              "type": "string",
                              "maxLength": 100
                            },
                            "series": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 100
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "definition": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                },
                "caveats": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "answers": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "question",
                      "answer",
                      "defaulted"
                    ],
                    "properties": {
                      "question": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "answer": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "defaulted": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "reason",
            "alternatives"
          ],
          "properties": {
            "action": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "maxLength": 300
            },
            "alternatives": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      ]
    }
  }
}
