{
  "type": "object",
  "title": "growth-lab panel summary",
  "description": "Plain-language description of the panel result. Numbers never appear in prose directly, only as claim ids such as {c1}",
  "additionalProperties": false,
  "required": ["prose", "claims"],
  "properties": {
    "prose": { "type": "string", "maxLength": 800 },
    "claims": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "op", "refs", "display"],
        "properties": {
          "id": { "type": "string", "pattern": "^c[0-9]{1,2}$" },
          "op": { "type": "string", "enum": ["value", "rate", "diff", "ratio", "sum"] },
          "refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row", "column"],
              "properties": {
                "row": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["column", "value"],
                    "properties": { "column": { "type": "string" }, "value": { "type": "string" } }
                  }
                },
                "column": { "type": "string" }
              }
            }
          },
          "display": { "type": "string", "maxLength": 30 }
        }
      }
    }
  }
}
